{
    "name": "stable-mixer/speech",
    "description": "On-device text to speech for Stable Mixer.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "StableMixer\\Speech\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StableMixer\\Speech\\SpeechServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
